# Optional: Gemini API Key (Optional; if omitted, router uses local Ollama / agy session)
GEMINI_API_KEY=

# Host & User Alignment
HOST_HOME=${HOME}
HOST_UID=1000
HOST_GID=1000
WORKSPACE_PATH=${HOME:-~}/development
PORT_ROUTER=8088
PYTHONUNBUFFERED=1

# Model Targets (Avoid 0% locked Gemini pool; use Claude Sonnet)
AGY_MODEL=claude-3-7-sonnet
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Headroom Proxy (AST Compression & Prompt Cache)
HEADROOM_PROXY=http://headroom:8787
