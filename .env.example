# Optional: Gemini API Key (Optional; if omitted, router uses local Ollama / agy session)
GEMINI_API_KEY=

# Ollama local model name
OLLAMA_MODEL=qwen2.5-coder:7b

# Gateway Port (Default: 8000)
PORT_ROUTER=8000

# Optional: Host paths for Antigravity CLI binary, auth credentials, and project workspace
# Defaults dynamically to ~/.local/bin/agy, ~/.local, ~/.config, and ~/development
# AGY_BIN_PATH=/home/username/.local/bin/agy
# HOST_LOCAL_PATH=/home/username/.local
# HOST_CONFIG_PATH=/home/username/.config
# WORKSPACE_PATH=/home/username/development
