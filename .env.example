# Optional: Gemini API Key (Optional; if omitted, router uses local Ollama / agy session)
GEMINI_API_KEY=

# Host & User Alignment
HOST_HOME=${HOME}
HOST_UID=1000
HOST_GID=1000
WORKSPACE_PATH=${HOST_HOME}/development
AGY_BIN_PATH=${HOST_HOME}/.local/bin/agy
HOST_LOCAL_PATH=${HOST_HOME}/.local
HOST_CONFIG_PATH=${HOST_HOME}/.config
HOST_GCLOUD_PATH=${HOST_HOME}/.config/gcloud
HOST_GEMINI_PATH=${HOST_HOME}/.gemini
PORT_ROUTER=8088
PYTHONUNBUFFERED=1

# Model Targets (e.g. gpt-oss-120b-medium, claude-sonnet-4-6, gemini-3.8-flash-high)
AGY_MODEL=gpt-oss-120b-medium
AGY_TIMEOUT=180
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=35

# Headroom Proxy (AST Compression & Prompt Cache)
HEADROOM_PROXY=http://headroom:8787
